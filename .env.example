# Email of the admin account. This user can view /admin and review submissions.
ADMIN_EMAIL=admin@example.com

# Hack Club OAuth (https://hackclub.com) — create an app to get real values.
HACKCLUB_CLIENT_ID=hackclub_client_id_placeholder
HACKCLUB_CLIENT_SECRET=hackclub_client_secret_placeholder
# Callback URI must match the one registered in your Hack Club app.
HACKCLUB_REDIRECT_URI=http://localhost:5173/auth

# Lapse OAuth (https://lapse.hackclub.com) — for tracking participant hours.
LAPSE_CLIENT_ID=lapse_client_id_placeholder
LAPSE_CLIENT_SECRET=lapse_client_secret_placeholder
# Callback URI must match the one registered in your Lapse app.
LAPSE_REDIRECT_URI=http://localhost:5173/lapse

# Only Lapse timelapses created at/after this ISO-8601 date are shown to users.
# Leave unset to default to 30 days before server start.
LAPSE_TIMELAPSE_SINCE=2026-08-01T00:00:00Z

# Tournament engine: how long to wait between battles (milliseconds).
# Defaults to 10000 (10s).
BATTLE_INTERVAL_MS=10000

# SurrealDB WebSocket URL. The site starts the DB on this address (default 8003).
SURREAL_URL=ws://localhost:8003